{
  "name": "ackaraca-portfolio",
  "version": "2.0.0",
  "description": "Ahmet Cem Karaca — architecture-informed product designer and developer portfolio",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "node scripts/build.mjs",
    "build:client": "vite build",
    "build:ssr": "vite build --ssr src/entry-server.tsx --outDir .ssr --emptyOutDir",
    "prerender": "node scripts/prerender.mjs",
    "content:sync-functions": "node scripts/sync-functions-content.mjs",
    "bootstrap:plan": "node scripts/plan-bundled-bootstrap.mjs",
    "preview": "vite preview",
    "deploy:production": "node scripts/deploy-production.mjs",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "audit:policy": "node scripts/check-audit-policy.mjs",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-ackaracame-test \"vitest run --config tests/rules/vitest.config.mjs\""
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "clsx": "^2.1.1",
    "firebase": "^12.19.0",
    "framer-motion": "^13.2.0",
    "lucide-react": "^1.45.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.88.0",
    "wouter": "^3.11.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "firebase-tools": "15.33.0",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.5",
    "basic-ftp": "^6.2.2",
    "qs": "^6.16.0",
    "chokidar": "^4.0.3"
  }
}
