{
  "name": "ackaraca-portfolio",
  "version": "2.0.0",
  "description": "Ahmet Cem Karaca — architecture-informed product designer and developer portfolio",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "node scripts/build.mjs",
    "build:client": "vite build",
    "build:ssr": "vite build --ssr src/entry-server.tsx --outDir .ssr --emptyOutDir",
    "prerender": "node scripts/prerender.mjs",
    "content:sync-functions": "node scripts/sync-functions-content.mjs",
    "bootstrap:plan": "node scripts/plan-bundled-bootstrap.mjs",
    "preview": "vite preview",
    "deploy:production": "node scripts/deploy-production.mjs",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "audit:policy": "node scripts/check-audit-policy.mjs",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-ackaracame-test \"vitest run --config tests/rules/vitest.config.mjs\""
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@hookform/resolvers": "^5.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.17.0",
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.84.0",
    "wouter": "^3.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "firebase-tools": "15.25.1",
    "globals": "^17.3.0",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
