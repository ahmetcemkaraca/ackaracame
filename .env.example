# Public Firebase web configuration. Values are identifiers, not server secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FUNCTIONS_REGION=europe-west1

# reCAPTCHA Enterprise key used by Firebase App Check in production.
VITE_FIREBASE_APPCHECK_SITE_KEY=

# Local development only. Never enable against production services.
VITE_FIREBASE_USE_EMULATORS=false
