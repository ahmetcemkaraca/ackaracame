{
  "name": "ackaracame-functions",
  "version": "1.0.0",
  "description": "Firebase functions for ackaraca.me",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "deploy": "firebase deploy --only functions",
    "seed:content": "node seed-content.mjs",
    "export:content": "node export-content.mjs",
    "media:publication": "node sync-media-publications.mjs",
    "rebuild:report": "node report-rebuild-result.mjs",
    "rebuild:claim": "node claim-rebuild-execution.mjs",
    "legacy:migrate-content": "node migrate-legacy-content.mjs",
    "legacy:retire": "node retire-legacy-functions.mjs",
    "auth:enable-totp": "node enable-totp.mjs",
    "owner:verify": "node verify-owner-account.mjs",
    "admin:claim": "node set-admin-claim.mjs",
    "test": "node --test",
    "test:watch": "node --test --watch"
  },
  "engines": {
    "node": "22"
  },
  "dependencies": {
    "firebase-admin": "^14.4.0",
    "firebase-functions": "^7.4.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
